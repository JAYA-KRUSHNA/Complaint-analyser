# ═════════════════════════════════════════════════════════════════
# CiviSense AI — Neon PostgreSQL Cloud Environment Configuration
# ═════════════════════════════════════════════════════════════════
# Instructions:
# 1. Create a free PostgreSQL database on https://neon.tech
# 2. In your Neon dashboard, select your project and click "Connection Details"
# 3. Toggle "Connection Pooling" to ON (recommended for serverless & multiple workers)
# 4. Copy your pooled connection string and paste below:

# ─── Database (Neon Serverless PostgreSQL) ───
# Pooled connection string (host contains '-pooler', includes ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── Security ───
SECRET_KEY=generate-a-strong-random-secret-key-minimum-32-chars-hex
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ─── Application ───
ENVIRONMENT=production
DEBUG=false
APP_NAME=CiviSense AI
APP_VERSION=1.0.0

# ─── CORS (Add your frontend cloud domains) ───
CORS_ORIGINS=https://civisense.vercel.app,https://civisense-ai.onrender.com,http://localhost:5173

# ─── Storage ───
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
