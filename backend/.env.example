# ─── Storage ───
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5
