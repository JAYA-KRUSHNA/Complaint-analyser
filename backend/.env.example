# ─── Database ───
DATABASE_URL=postgresql+asyncpg://civisense:civisense_dev_2024@localhost:5433/civisense_db
DATABASE_URL_SYNC=postgresql://civisense:civisense_dev_2024@localhost:5433/civisense_db

# ─── Security ───
SECRET_KEY=change-this-to-a-random-string-minimum-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ───
ENVIRONMENT=development
DEBUG=true
APP_NAME=CiviSense AI
